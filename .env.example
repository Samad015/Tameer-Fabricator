NODE_ENV=development
HTTP_PORT=8080
# Use URL-safe random values. Generate each with: openssl rand -hex 32
MONGO_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=http://localhost:8080
EMAIL_USER=
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Nominatim-compatible hosted or self-hosted provider; blank enables manual fallback.
GEOCODER_URL=
GEOCODER_USER_AGENT=TameerFabricators/1.0 (contact: your-email@example.com)

# Server-side only. Never use a VITE_ prefix for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
